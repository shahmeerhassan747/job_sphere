 # # =============================================================================

 # # Application Settings

 # # =============================================================================

  APP_ENV=development

  APP_PORT=8000

   #

   # # =============================================================================

   # # Database Configuration

   # # =============================================================================

   # # Option 1: Individual Database Fields (Recommended for development)

   # DB_ENGINE=postgresql+psycopg2

   # DB_USER=postgres

   # DB_PASSWORD=postgres

   # DB_HOST=localhost

   # DB_PORT=5432

   # DB_NAME=job

   #

   # # Option 2: Alternative - Single Database URL (uncomment to use instead of individual fields)

   DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/job"

   #

   # # =============================================================================

   # # JWT Authentication

   # # =============================================================================

   # # IMPORTANT: Change this to a secure random string in production

   # # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

   JWT_SECRET_KEY=f28c59337162ce322f3db0de828d0533a92a1c4ee9a803e11db84bab941f57ee

   JWT_ALGORITHM=HS256

   JWT_EXPIRE_DAYS=1000

